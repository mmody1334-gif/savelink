{
  "name": "savelink",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram bot + web app that turns TikTok / Instagram / Facebook / Pinterest links into MP4 or MP3.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tg:setup": "node scripts/setup-telegram.mjs",
    "tg:delete": "node scripts/setup-telegram.mjs --delete",
    "cookie:check": "node scripts/check-cookie.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
